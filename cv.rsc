b:["$","section",null,{"children":[["$","h2",null,{"children":"Research"}],[["$","div","hopfield",{"className":"cv-row cv-research","children":[["$","span",null,{"children":"Mar — Aug 2026"}],["$","div",null,{"children":[["$","h3",null,{"children":"University of Chicago · James Franck Institute"}],["$","p",null,{"className":"cv-role","children":"Research intern · Vincenzo Vitelli"}],["$","p",null,{"children":"Demonstrated numerically that finite non-reciprocal Hopfield networks differ qualitatively from their thermodynamic limit. Using Python for sample-resolved continuation, delay dynamics, spectral stability and Lyapunov analysis, uncovered how memory-specific saddle-node bifurcations assemble the transition from static to sequential recall."}],["$","a",null,{"href":"/research/hopfield.html","children":"Project, methods & documents →"}]]}]]}],["$","div","learning",{"className":"cv-row cv-research","children":[["$","span",null,{"children":"Sep 2025 — Mar 2026"}],["$","div",null,{"children":[["$","h3",null,{"children":"École normale supérieure · Paris"}],["$","p",null,{"className":"cv-role","children":"Research project · Rémi Monasson"}],["$","p",null,{"children":"Studied how data geometry controls autoencoder interpolation. Connected synthetic high-dimensional experiments, covariance spectra and a replica calculation for an asymmetric encoder–decoder architecture."}],["$","a",null,{"href":"/research/learning.html","children":"Project, methods & documents →"}]]}]]}],["$","div","plasma",{"className":"cv-row cv-research","children":[["$","span",null,{"children":"Sep 2024 — Sep 2025"}],["$","div",null,{"children":[["$","h3",null,{"children":"Laboratoire de Physique des Plasmas · École Polytechnique"}],["$","p",null,{"className":"cv-role","children":"Collective research project · Federico Petronio"}],["$","p",null,{"children":"Established a feasibility window for air-breathing electric propulsion in very low Earth orbit by developing a nine-species plasma solver and mapping atmospheric conditions, discharge power and losses to the thrust–drag balance."}],["$","a",null,{"href":"/research/plasma.html","children":"Project, methods & documents →"}]]}]]}],["$","div","tropical",{"className":"cv-row cv-research","children":[["$","span",null,{"children":"Sep 2024 — Jan 2025"}],["$","div",null,{"children":[["$","h3",null,{"children":"École Polytechnique"}],["$","p",null,{"className":"cv-role","children":"Pure mathematics essay · Omid Amini"}],["$","p",null,{"children":"Developed a proof-based account of the passage from complex amoebas to tropical varieties through Ronkin functions, convexity, Hausdorff limits and non-Archimedean valuations."}],["$","a",null,{"href":"/research/tropical.html","children":"Project, methods & documents →"}]]}]]}]]]}]
