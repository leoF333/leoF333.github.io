perties of high-dimensional data make its latent dynamics learnable?"}],false]}]]}],["$","article","plasma",{"className":"project","children":[["$","div",null,{"children":[["$","p",null,{"className":"project-meta","children":["03"," / ","ÉCOLE POLYTECHNIQUE · LPP"," · ","2024 – 2025 · Published 2026"]}],"$Lb","$Lc","$Ld","$Le","$Lf"]}],"$L10"]}],"$L11"]]}],"$L12","$L13"]}]
