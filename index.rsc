c:["$","article","plasma",{"className":"project","children":[["$","div",null,{"children":[["$","p",null,{"className":"project-meta","children":["03"," / ","ÉCOLE POLYTECHNIQUE · LPP"," · ","2024 – 2025 · Published 2026"]}],["$","h2",null,{"children":["$","a",null,{"className":"project-title","href":"/research/plasma.html","children":"Why satellites should breathe"}]}],["$","p",null,{"children":"We turned upper-atmosphere chemistry into a fast plasma model, then asked whether the resulting thrust could pay back atmospheric drag."}],["$","p",null,{"className":"tags","children":"Plasma physics / Coupled ODEs / Model validation"}],["$","div",null,{"className":"links","children":[["$","a",null,{"href":"/research/plasma.html","children":"Read the project →"}],["$","a",null,{"href":"https://doi.org/10.1063/5.0327675","children":["Publication"," ↗"]}]]}],["$","p",null,{"className":"status-label","children":"Physics of Plasmas · 2026"}]]}],["$","div",null,{"className":"research-note","children":[["$","span",null,{"className":"note-label","children":"THE CENTRAL QUESTION"}],["$","p",null,{"children":"Can the atmosphere that slows a satellite also become its propellant?"}],false]}]]}]
d:["$","article","tropical",{"className":"project","children":[["$","div",null,{"children":[["$","p",null,{"className":"project-meta","children":["04"," / ","ÉCOLE POLYTECHNIQUE"," · ","September 2024 – January 2025"]}],["$","h2",null,{"children":["$","a",null,{"className":"project-title","href":"/research/tropical.html","children":"From complex analysis to tropical geometry"}]}],["$","p",null,{"children":"A complex zero set can collapse into a piecewise-linear skeleton. This essay follows the proof—from amoebas and Ronkin functions to valuations."}],["$","p",null,{"className":"tags","children":"Pure mathematics / Algebraic geometry / Proofs"}],["$","div",null,{"className":"links","children":[["$","a",null,{"href":"/research/tropical.html","children":"Read the project →"}],["$","a",null,{"href":"/documents/tropical-geometry.pdf","children":["Report"," ↗"]}]]}],["$","p",null,{"className":"status-label","children":"Collective mathematical essay"}]]}],["$","div",null,{"className":"research-note","children":[["$","span",null,{"className":"note-label","children":"THE CENTRAL QUESTION"}],["$","p",null,{"children":"What survives when an algebraic variety is viewed only through asymptotic scale?"}],false]}]]}]
